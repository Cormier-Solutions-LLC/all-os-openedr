<group name="openedr,audit,">
  <rule id="110110" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.type" type="pcre2">^SYSCALL$</field>
    <field name="audit.success" type="pcre2">^yes$</field>
    <field name="audit.key" type="pcre2">^openedr-restricted-exec$</field>
    <description>OpenEDR protected executable used by an unexpected login identity</description>
    <options>no_full_log</options>
    <group>openedr_execution_policy,</group>
  </rule>
  <rule id="110111" level="3">
    <if_sid>80700</if_sid>
    <field name="audit.type" type="pcre2">^SYSCALL$</field>
    <field name="audit.success" type="pcre2">^yes$</field>
    <field name="audit.key" type="pcre2">^openedr-session-exec$</field>
    <description>OpenEDR login session executed a process</description>
    <options>no_full_log</options>
    <group>openedr_process_execution,</group>
  </rule>
  <rule id="110112" level="8">
    <if_sid>80700</if_sid>
    <match type="pcre2">^(?:node=\S+ )?type=AVC msg=audit\([0-9]+\.[0-9]+:[0-9]+\):\s+apparmor="DENIED"\s+operation="exec"(?:\s+class="file")?\s+profile="all-os-openedr-[a-z0-9][a-z0-9-]{0,47}"\s</match>
    <description>OpenEDR AppArmor workload blocked an executable before launch</description>
    <group>openedr_execution_prevention,</group>
  </rule>
  <rule id="110113" level="8">
    <if_sid>80700</if_sid>
    <match type="pcre2">^(?:node=\S+ )?type=AVC msg=audit\([0-9]+\.[0-9]+:[0-9]+\):\s+apparmor="DENIED"\s+operation="[^"]+"\s+class="file"(?:(?!\s+type=)[^\x1d])*?\sprofile="all-os-openedr-[a-z0-9][a-z0-9-]{0,47}"(?:(?!\s+type=)[^\x1d])*?\sdenied_mask="[a-z]*[wacdl][a-z]*"</match>
    <description>OpenEDR AppArmor workload blocked a file mutation</description>
    <group>openedr_file_protection,</group>
  </rule>
  <rule id="110118" level="5">
    <if_sid>80700</if_sid>
    <field name="audit.type" type="pcre2">^SYSCALL$</field>
    <field name="audit.success" type="pcre2">^yes$</field>
    <field name="audit.key" type="pcre2">^openedr-config-change$</field>
    <description>OpenEDR observed write access or an attribute change on monitored configuration</description>
    <group>openedr_configuration_change,</group>
  </rule>
  <rule id="110119" level="8">
    <if_sid>80700</if_sid>
    <match type="pcre2">^(?:node=\S+ )?type=INTEGRITY_DATA msg=audit\([0-9]+\.[0-9]+:[0-9]+\):\s+pid=[0-9]+ uid=[0-9]+ auid=[0-9]+ ses=[0-9]+(?:(?!\s+type=)[^\x1d])*?\sop=appraise_data\scause=\S+(?:(?!\s+type=)[^\x1d])*?\sres=0\serrno=-?[0-9]+(?:[\s\x1d]|$)</match>
    <description>Linux IMA appraisal failure</description>
    <group>openedr_execution_integrity,</group>
  </rule>
</group>
