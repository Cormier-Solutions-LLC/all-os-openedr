<group name="openedr,audit,">
  <rule id="110110" level="8">
    <if_sid>80700</if_sid>
    <field name="audit.type" type="pcre2">^SYSCALL$</field>
    <field name="audit.success" type="pcre2">^yes$</field>
    <field name="audit.key" type="pcre2">^openedr-restricted-exec$</field>
    <description>OpenEDR protected executable used by an unexpected login identity</description>
    <options>no_full_log</options>
    <group>openedr_execution_policy,</group>
  </rule>
  <rule id="110111" level="3">
    <if_sid>80700</if_sid>
    <field name="audit.type" type="pcre2">^SYSCALL$</field>
    <field name="audit.success" type="pcre2">^yes$</field>
    <field name="audit.key" type="pcre2">^openedr-session-exec$</field>
    <description>OpenEDR login session executed a process</description>
    <options>no_full_log</options>
    <group>openedr_process_execution,</group>
  </rule>
  <rule id="110112" level="8">
    <if_sid>80700</if_sid>
    <match type="pcre2">^(?:node=\S+ )?type=AVC msg=audit\([0-9]+\.[0-9]+:[0-9]+\):\s+apparmor="DENIED"\s+operation="exec"(?:\s+class="file")?\s+profile="all-os-openedr-[a-z0-9][a-z0-9-]{0,47}"\s</match>
    <description>OpenEDR AppArmor workload blocked an executable before launch</description>
    <group>openedr_execution_prevention,</group>
  </rule>
</group>
