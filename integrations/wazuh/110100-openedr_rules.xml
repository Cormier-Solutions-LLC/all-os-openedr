<group name="openedr,">
  <rule id="110100" level="0">
    <decoded_as>json</decoded_as>
    <field name="openedr_source" type="pcre2">^all-os-openedr$</field>
    <field name="openedr_schema" type="pcre2">^1$</field>
    <description>All OS OpenEDR event</description>
  </rule>
  <rule id="110101" level="3">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^process\.observed$</field>
    <description>All OS OpenEDR process observed</description>
    <options>no_full_log</options>
  </rule>
</group>
