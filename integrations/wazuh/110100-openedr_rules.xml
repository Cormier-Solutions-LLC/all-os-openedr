<group name="openedr,">
  <rule id="110100" level="0">
    <decoded_as>json</decoded_as>
    <field name="openedr_source" type="pcre2">^all-os-openedr$</field>
    <field name="openedr_schema" type="pcre2">^1$</field>
    <description>All OS OpenEDR event</description>
  </rule>
  <rule id="110101" level="3">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^process\.observed$</field>
    <description>All OS OpenEDR process observed</description>
    <options>no_full_log</options>
  </rule>
  <rule id="110102" level="3">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^process\.(fork|exec|task_exit)$</field>
    <description>All OS OpenEDR process lifecycle event</description>
    <options>no_full_log</options>
    <group>openedr_process_lifecycle,</group>
  </rule>
  <rule id="110103" level="8">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^process\.stream_gap$</field>
    <description>All OS OpenEDR kernel process stream lost continuity</description>
    <options>no_full_log</options>
    <group>openedr_sensor_health,</group>
  </rule>
  <rule id="110104" level="8">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^response\.network_isolation$</field>
    <description>All OS OpenEDR network isolation audit event</description>
    <options>no_full_log</options>
    <group>openedr_response,</group>
  </rule>
  <rule id="110105" level="3">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^file\.(access|modify|metadata_change|close_write|close_readonly|open|create|delete|open_exec|rename)$</field>
    <description>All OS OpenEDR file provenance event</description>
    <options>no_full_log</options>
    <group>openedr_file_provenance,</group>
  </rule>
  <rule id="110106" level="8">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^file\.stream_gap$</field>
    <description>All OS OpenEDR file provenance stream lost continuity</description>
    <options>no_full_log</options>
    <group>openedr_sensor_health,</group>
  </rule>
  <rule id="110107" level="3">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^executable\.open$</field>
    <description>All OS OpenEDR observed a file opened for execution</description>
    <options>no_full_log</options>
    <group>openedr_executable,</group>
  </rule>
  <rule id="110108" level="8">
    <if_sid>110107</if_sid>
    <field name="openedr_executable_verdict" type="pcre2">^untrusted$</field>
    <description>All OS OpenEDR observed an executable listed as untrusted in the local catalog</description>
    <options>no_full_log</options>
    <group>openedr_executable_verdict,</group>
  </rule>
  <rule id="110119" level="8">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^executable\.integrity_failure$</field>
    <description>Linux IMA appraisal failure</description>
    <options>no_full_log</options>
    <group>openedr_execution_integrity,</group>
  </rule>
</group>
