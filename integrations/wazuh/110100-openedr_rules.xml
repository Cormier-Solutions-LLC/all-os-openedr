<group name="openedr,">
  <rule id="110100" level="0">
    <decoded_as>json</decoded_as>
    <field name="openedr_source" type="pcre2">^all-os-openedr$</field>
    <field name="openedr_schema" type="pcre2">^1$</field>
    <description>All OS OpenEDR event</description>
  </rule>
  <rule id="110101" level="3">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^process\.observed$</field>
    <description>All OS OpenEDR process observed</description>
    <options>no_full_log</options>
  </rule>
  <rule id="110102" level="3">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^process\.(fork|exec|task_exit)$</field>
    <description>All OS OpenEDR process lifecycle event</description>
    <options>no_full_log</options>
    <group>openedr_process_lifecycle,</group>
  </rule>
  <rule id="110103" level="8">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^process\.stream_gap$</field>
    <description>All OS OpenEDR kernel process stream lost continuity</description>
    <options>no_full_log</options>
    <group>openedr_sensor_health,</group>
  </rule>
  <rule id="110104" level="8">
    <if_sid>110100</if_sid>
    <field name="openedr_event" type="pcre2">^response\.network_isolation$</field>
    <description>All OS OpenEDR network isolation audit event</description>
    <options>no_full_log</options>
    <group>openedr_response,</group>
  </rule>
</group>
