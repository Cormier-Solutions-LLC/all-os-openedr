{
  "policy": {
    "description": "Example 30-day retention for dedicated OpenEDR alert indices",
    "default_state": "retain",
    "states": [
      {
        "name": "retain",
        "actions": [],
        "transitions": [
          {"state_name": "delete", "conditions": {"min_index_age": "30d"}}
        ]
      },
      {
        "name": "delete",
        "actions": [{"delete": {}}],
        "transitions": []
      }
    ],
    "ism_template": [
      {"index_patterns": ["openedr-alerts-v1-*"], "priority": 100}
    ]
  }
}
