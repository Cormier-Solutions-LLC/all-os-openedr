{
  "index_patterns": ["openedr-alerts-v1-*"],
  "priority": 200,
  "version": 3,
  "template": {
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": {"type": "date"},
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||yyyy-MM-dd'T'HH:mm:ss.SSSZ"
        },
        "agent": {
          "properties": {
            "id": {"type": "keyword"},
            "name": {"type": "keyword"}
          }
        },
        "rule": {
          "properties": {
            "id": {"type": "keyword"},
            "level": {"type": "integer"},
            "description": {"type": "text"}
          }
        },
        "data": {
          "properties": {
            "openedr_source": {"type": "keyword"},
            "openedr_schema": {"type": "integer"},
            "openedr_event": {"type": "keyword"},
            "openedr_event_id": {"type": "keyword"},
            "openedr_host": {"type": "keyword", "ignore_above": 256},
            "openedr_observed_at": {"type": "date"},
            "openedr_pid": {"type": "long"},
            "openedr_tid": {"type": "long"},
            "openedr_parent_pid": {"type": "long"},
            "openedr_parent_tid": {"type": "long"},
            "openedr_process_id": {"type": "keyword"},
            "openedr_parent_process_id": {"type": "keyword"},
            "openedr_boot_id": {"type": "keyword"},
            "openedr_stream_id": {"type": "keyword"},
            "openedr_thread_group_leader": {"type": "boolean"},
            "openedr_wait_status": {"type": "long"},
            "openedr_kernel_cpu": {"type": "integer"},
            "openedr_kernel_sequence": {"type": "long"},
            "openedr_kernel_monotonic_ns": {"type": "long"},
            "openedr_gap_reason": {"type": "keyword"},
            "openedr_missing_events": {"type": "long"},
            "openedr_response_action": {"type": "keyword"},
            "openedr_response_agent": {"type": "keyword"},
            "openedr_response_alert": {"type": "keyword"},
            "openedr_response_signer": {"type": "keyword"},
            "openedr_response_lease": {"type": "keyword"},
            "openedr_response_result": {"type": "keyword"},
            "openedr_response_reason": {"type": "keyword"},
            "openedr_response_deadline_ms": {"type": "long"},
            "openedr_process": {"type": "keyword", "ignore_above": 256}
          }
        }
      }
    }
  }
}
