{
  "index_patterns": ["openedr-alerts-v1-*"],
  "priority": 200,
  "version": 13,
  "template": {
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": {"type": "date"},
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||yyyy-MM-dd'T'HH:mm:ss.SSSZ"
        },
        "agent": {
          "properties": {
            "id": {"type": "keyword"},
            "name": {"type": "keyword"}
          }
        },
        "rule": {
          "properties": {
            "id": {"type": "keyword"},
            "level": {"type": "integer"},
            "description": {"type": "text"}
          }
        },
        "data": {
          "properties": {
            "openedr_source": {"type": "keyword"},
            "openedr_schema": {"type": "integer"},
            "openedr_event": {"type": "keyword"},
            "openedr_event_id": {"type": "keyword"},
            "openedr_host": {"type": "keyword", "ignore_above": 256},
            "openedr_observed_at": {"type": "date"},
            "openedr_pid": {"type": "long"},
            "openedr_tid": {"type": "long"},
            "openedr_parent_pid": {"type": "long"},
            "openedr_parent_tid": {"type": "long"},
            "openedr_process_id": {"type": "keyword"},
            "openedr_parent_process_id": {"type": "keyword"},
            "openedr_boot_id": {"type": "keyword"},
            "openedr_stream_id": {"type": "keyword"},
            "openedr_thread_group_leader": {"type": "boolean"},
            "openedr_wait_status": {"type": "long"},
            "openedr_kernel_cpu": {"type": "integer"},
            "openedr_kernel_sequence": {"type": "long"},
            "openedr_kernel_monotonic_ns": {"type": "long"},
            "openedr_gap_reason": {"type": "keyword"},
            "openedr_missing_events": {"type": "long"},
            "openedr_response_action": {"type": "keyword"},
            "openedr_response_agent": {"type": "keyword"},
            "openedr_response_alert": {"type": "keyword"},
            "openedr_response_signer": {"type": "keyword"},
            "openedr_response_lease": {"type": "keyword"},
            "openedr_response_result": {"type": "keyword"},
            "openedr_response_reason": {"type": "keyword"},
            "openedr_response_deadline_ms": {"type": "long"},
            "openedr_file_scope": {"type": "keyword", "ignore_above": 4096},
            "openedr_file_mask": {"type": "long"},
            "openedr_file_notification_id": {"type": "keyword"},
            "openedr_file_directory": {"type": "boolean"},
            "openedr_file_filesystem_id": {"type": "keyword"},
            "openedr_file_object_id": {"type": "keyword"},
            "openedr_file_attribution": {"type": "keyword"},
            "openedr_file_actor_id": {"type": "keyword"},
            "openedr_file_observed_uid": {"type": "long"},
            "openedr_file_observed_euid": {"type": "long"},
            "openedr_file_parent_id": {"type": "keyword"},
            "openedr_file_name": {"type": "keyword", "ignore_above": 1024},
            "openedr_file_name_bytes": {"type": "keyword", "ignore_above": 1024},
            "openedr_file_path": {"type": "keyword", "ignore_above": 4096},
            "openedr_file_path_source": {"type": "keyword"},
            "openedr_file_old_parent_id": {"type": "keyword"},
            "openedr_file_old_name": {"type": "keyword", "ignore_above": 1024},
            "openedr_file_old_name_bytes": {"type": "keyword", "ignore_above": 1024},
            "openedr_file_old_path": {"type": "keyword", "ignore_above": 4096},
            "openedr_file_old_path_source": {"type": "keyword"},
            "openedr_executable_path": {"type": "keyword", "ignore_above": 4096},
            "openedr_executable_measurement": {"type": "keyword"},
            "openedr_executable_size": {"type": "long"},
            "openedr_executable_device": {"type": "keyword"},
            "openedr_executable_inode": {"type": "keyword"},
            "openedr_executable_sha256": {"type": "keyword"},
            "openedr_executable_format": {"type": "keyword"},
            "openedr_executable_catalog_sha256": {"type": "keyword"},
            "openedr_executable_verdict": {"type": "keyword"},
            "openedr_executable_volume_uuid": {"type": "keyword"},
            "openedr_uid": {"type": "long"},
            "openedr_requester_uid": {"type": "long"},
            "openedr_containment_application": {"type": "keyword"},
            "openedr_containment_launch_id": {"type": "keyword"},
            "openedr_containment_decision": {"type": "keyword"},
            "openedr_containment_reason": {"type": "keyword"},
            "openedr_containment_interpreter": {"type": "keyword"},
            "openedr_containment_exit_code": {"type": "integer"},
            "openedr_containment_pid": {"type": "long"},
            "openedr_containment_pid_namespace": {"type": "long"},
            "openedr_containment_monitor_pid": {"type": "long"},
            "openedr_containment_fork_after_ns": {"type": "long"},
            "openedr_containment_fork_before_ns": {"type": "long"},
            "openedr_containment_audit_session": {"type": "long"},
            "openedr_containment_activity_operation": {"type": "keyword"},
            "openedr_containment_activity_class": {"type": "keyword"},
            "openedr_containment_activity_result": {"type": "keyword"},
            "openedr_containment_activity_errno": {"type": "integer"},
            "openedr_ima_uid": {"type": "long"},
            "openedr_ima_auid": {"type": "long"},
            "openedr_ima_audit_serial": {"type": "keyword"},
            "openedr_ima_cause": {"type": "keyword"},
            "openedr_process": {"type": "keyword", "ignore_above": 256}
          }
        }
      }
    }
  }
}
