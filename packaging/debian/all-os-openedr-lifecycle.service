[Unit]
Description=All OS OpenEDR kernel process lifecycle

[Service]
Type=simple
WorkingDirectory=/usr/lib/all-os-openedr
ExecStart=/usr/bin/python3 -B -m all_os_openedr --collector linux-proc-connector --output /var/log/all-os-openedr-lifecycle/events.jsonl
DynamicUser=yes
LogsDirectory=all-os-openedr-lifecycle
LogsDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_NETLINK
CapabilityBoundingSet=
KillSignal=SIGINT
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
