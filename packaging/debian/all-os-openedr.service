[Unit]
Description=All OS OpenEDR Linux telemetry preview

[Service]
Type=simple
WorkingDirectory=/usr/lib/all-os-openedr
ExecStart=/usr/bin/python3 -B -m all_os_openedr
DynamicUser=yes
LogsDirectory=all-os-openedr
LogsDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
