[Unit]
Description=All OS OpenEDR outbound DNS question evidence
After=local-fs.target

[Service]
Type=simple
WorkingDirectory=/usr/lib/all-os-openedr
ExecStart=/usr/bin/python3 -B -m all_os_openedr.dns_observations
LogsDirectory=all-os-openedr-dns
LogsDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
LimitMEMLOCK=infinity
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
