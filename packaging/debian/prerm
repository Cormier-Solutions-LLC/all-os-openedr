#!/bin/sh
set -eu
case "$1" in
    remove|deconfigure)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop all-os-openedr.service all-os-openedr-lifecycle.service \
                all-os-openedr-file-provenance.service all-os-openedr-executable.service all-os-openedr-launch.socket
        fi
        deb-systemd-helper disable all-os-openedr.service all-os-openedr-lifecycle.service \
            all-os-openedr-file-provenance.service all-os-openedr-executable.service all-os-openedr-launch.socket >/dev/null
        ;;
esac
