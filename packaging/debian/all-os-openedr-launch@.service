[Unit]
Description=All OS OpenEDR local containment request
PartOf=all-os-openedr-launch.socket
CollectMode=inactive-or-failed

[Service]
User=openedr-broker
ExecStart=/usr/lib/all-os-openedr/all-os-openedr-launch-broker
StandardInput=socket
StandardOutput=null
StandardError=append:/var/log/all-os-openedr-containment/launches.jsonl
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
TemporaryFileSystem=/run/all-os-openedr-export:rw,nosuid,nodev,noexec,size=16M,mode=1777
UMask=0077
RuntimeMaxSec=60s
TasksMax=48
MemoryMax=256M
